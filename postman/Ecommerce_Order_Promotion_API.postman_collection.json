              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status [200]', () => pm.expect([200]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "    const product = pm.response.json().data.find(item => item.status === 'active' && item.stock_quantity >= 2);",
                  "    pm.test('A stocked example product exists', () => pm.expect(product).to.be.an('object'));",
                  "    if (product && Number.isSafeInteger(product.id)) {",

        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/register",
            "description": "Set a fresh email and a strong private password. Duplicate email or invalid fields: 422. Throttle: 429. Expected success: 201.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Assessment Customer\",\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\",\n  \"password_confirmation\": \"{{customer_password}}\",\n  \"device_name\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status [201]', () => pm.expect([201]).to.include(pm.response.code));",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "    const result = pm.response.json().data;",
                  "    pm.test('Token issued', () => pm.expect(result.token).to.be.a('string').and.not.empty);",
                  "    if (typeof result.token === 'string' && result.token.length > 0) {",
                  "        pm.collectionVariables.set('bearer_token', result.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {

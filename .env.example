APP_NAME="E-Commerce Order API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8091
APP_PORT=8091
CATALOGUE_CURRENCY=USD

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
# Optional host access to this project's PostgreSQL; container traffic uses DB_PORT.
DB_FORWARD_PORT=15433
DB_DATABASE=ecommerce_order_api
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=ecommerce-order-api-local-
CATALOGUE_CACHE_ENABLED=true
CATALOGUE_CACHE_STORE=catalogue
CATALOGUE_CACHE_NAMESPACE=ecommerce:catalogue:local
CATALOGUE_CACHE_PREFIX=ecommerce-catalogue-
CATALOGUE_CACHE_TTL=45
CATALOGUE_REDIS_DB=2
CATALOGUE_REDIS_TIMEOUT=0.2
# Optional authenticated/TLS connection URL, supplied privately:
# CATALOGUE_REDIS_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PostgreSQL outbox with an independent Redis queue (catalogue uses DB 2).
ORDER_EVENTS_QUEUE_CONNECTION=order-redis
ORDER_EVENTS_QUEUE=order-events-local
ORDER_EVENTS_REDIS_DB=4
ORDER_EVENTS_LEASE_SECONDS=300
ORDER_EVENTS_DISPATCH_RETRY_SECONDS=15
ORDER_EVENTS_BATCH_SIZE=100

# Shared native HTTP throttling; catalogue DB 2 and queue DB 4 remain independent.
RATE_LIMIT_REDIS_DB=6
# Optional private authenticated/TLS limiter Redis URL:
# RATE_LIMIT_REDIS_URL=
# Defaults to ecommerce:rate-limits:APP_ENV:v1: (use a unique prefix per deployment).
# RATE_LIMIT_REDIS_PREFIX=
# Comma-separated trusted reverse-proxy IPs/CIDRs; empty trusts no proxies.
TRUSTED_PROXIES=
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_IP_PER_MINUTE=30
RATE_LIMIT_LOGIN_ACCOUNT_IP_PER_MINUTE=5
RATE_LIMIT_LOGIN_ACCOUNT_PER_MINUTE=20
RATE_LIMIT_CATALOGUE_PER_MINUTE=120
RATE_LIMIT_HEALTH_PER_MINUTE=120
RATE_LIMIT_CART_READ_PER_MINUTE=120
RATE_LIMIT_CART_MUTATION_PER_MINUTE=60
RATE_LIMIT_PROMOTION_PER_MINUTE=30
RATE_LIMIT_CHECKOUT_PER_MINUTE=20
RATE_LIMIT_ORDER_READ_PER_MINUTE=120
RATE_LIMIT_ORDER_CANCEL_PER_MINUTE=20
RATE_LIMIT_ADMIN_READ_PER_MINUTE=120
RATE_LIMIT_ADMIN_MUTATION_PER_MINUTE=30
RATE_LIMIT_ACCOUNT_READ_PER_MINUTE=120
RATE_LIMIT_ACCOUNT_MUTATION_PER_MINUTE=30
